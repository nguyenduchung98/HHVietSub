{
  "name": "hhvietsub-lite",
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "description": "HHVietSub Lite - CapCut TTS and low-resource sync",
  "author": "HHVietSub Team",
  "license": "MIT",
  "homepage": "https://github.com/nguyenduchung98/HHVietSub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenduchung98/HHVietSub.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenduchung98/HHVietSub/issues"
  },
  "keywords": [
    "capcut",
    "ffmpeg",
    "srt",
    "subtitles",
    "text-to-speech",
    "vietnamese"
  ],
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && electron .\"",
    "dev:web": "vite",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:web": "vite build",
    "runtime:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "package:win": "npm run runtime:prepare && npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "backend:check": "node scripts/backend-check.mjs",
    "test:backend": "node scripts/backend-test.mjs",
    "test": "node scripts/test.mjs"
  },
  "build": {
    "appId": "com.hhvietsub.lite",
    "productName": "HHVietSub Lite",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**/*",
          "!**/__pycache__/**/*",
          "!**/*.pyc",
          "!engines/omnivoice_*.py",
          "!engines/vieneu_*.py",
          "!engines/download_model.py",
          "!services/model_service.py",
          "!services/gemini_translation_service.py",
          "!services/voice_studio_service.py"
        ]
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "ffmpeg/**/*",
          "capcut-cli/**/*"
        ]
      },
      {
        "from": "runtime/python",
        "to": "runtime/python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asar": true,
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
