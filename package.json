{
  "name": "dich-capcut-studio",
  "version": "0.1.0-dev",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "backend:check": "node scripts/backend-check.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
